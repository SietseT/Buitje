# Used by docker-compose.yml / docker-compose.prod.yml (via env_file).
# See apps/backend/.env.example for the same vars, used for local (non-Docker) dev.

# KNMI Open Data API key, sent as the raw Authorization header value.
#
# The line below is KNMI's own published anonymous/demo key (shared across
# all unregistered users, rate-limited: 3000 requests/hour, valid until
# 1 Aug 2027). Source: https://developer.dataplatform.knmi.nl/open-data-api
# Fine for trying it out. For real deployment, register a free personal key at
# https://developer.dataplatform.knmi.nl for a dedicated, higher quota.
KNMI_API_KEY=eyJvcmciOiI1ZTU1NGUxOTI3NGE5NjAwMDEyYTNlYjEiLCJpZCI6IjUzYTg1ZDBhMmQ5YzRkYzJiYWNlNzQ4NTQ2Zjk4ODExIiwiaCI6Im11cm11cjEyOCJ9

# PORT=3001
# POLL_INTERVAL_MS=300000
# MAX_FRAMES=24
# BACKFILL_CONCURRENCY=8
# LOG_REQUESTS=true

# Shows a GitHub icon in the app that links here. Unset by default so a
# self-hosted instance doesn't silently link to someone else's repo.
# GITHUB_URL=https://github.com/SietseT/Buitje

# LIGHTNING_BOUNDS_PADDING=1.5
# LIGHTNING_RETENTION_MS=7200000
# LIGHTNING_MAX_STRIKES=20000
# LIGHTNING_FLUSH_INTERVAL_MS=30000
# LIGHTNING_RECONNECT_BASE_MS=2000
# LIGHTNING_RECONNECT_MAX_MS=60000
# LIGHTNING_STALE_MS=120000
